* text=auto
*.dart text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.csv text eol=lf
# Preserve the approved content pack's byte hash across clones.
assets/vocabulary/reviewed500.csv -text
pubspec.lock text eol=lf
*.sh text eol=lf
*.ps1 text eol=crlf
*.bat text eol=crlf
*.png binary
*.ico binary
*.wav binary

# Audit snapshots and source plans bind exact bytes through SHA-256.
# Preserve them across Windows/Linux checkouts instead of normalizing newlines.
# Allow intentional CRLF endings while retaining ordinary whitespace checks.
docs/p6/p6c/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
docs/p6/p6c1/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
scripts/p6c/*.py -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
scripts/p6c1/*.py -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
docs/p6/P6C_CORE_MEANINGS_PILOT_REPORT.md -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
docs/p6/P6C1_INDEPENDENT_REVIEW_REPORT.md -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol

# Later isolated review checkpoints also bind the original artifact bytes.
docs/p6/p6c[2-5]/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
docs/p6/p6c5a/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
scripts/p6c[2-5]/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
scripts/p6c5a/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
test/p6c[2-5]/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
test/p6c5a/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
# Command transcripts keep the terminal's intentional blank footer unchanged.
docs/p6/p6c5a/verification/*.txt -text whitespace=blank-at-eol,space-before-tab,cr-at-eol,-blank-at-eof
